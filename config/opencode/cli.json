{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full",
    "image_preview": false,
    "editor": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "autoaccept",
    "grouping": "auto",
    "verbosity": "medium"
  },
  "animations": true,
  "terminal": {
    "copy": "select"
  },
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": true
  }
}
